# Verbalis environment — copy to `.env.local` for local dev (git-ignored).
#
# Leave everything unset to run Verbalis in 100% local mode (no accounts, no
# network). Set the two VITE_SUPABASE_* vars to enable the optional signed-in
# mode (accounts, sync, cloud projects). See docs/cloud.md for full setup.
#
# The publishable/anon key below is SAFE to expose: it ships in the client
# bundle by design and every table is gated by Row-Level Security. NEVER put the
# Supabase *secret* key (sb_secret_...) in this file, the repo, or the bundle —
# Verbalis is client-side and never needs it.

VITE_SUPABASE_URL=https://qutcuzlppbjbsymowavc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_c8YdrT2-abKdW1Kl7FDKyA_v5OwqLdY

# Comma-separated Supabase provider ids to show as "Continue with" buttons:
# google, azure (Microsoft), apple. Defaults to `google` when unset. Only list
# providers you have configured in the Supabase dashboard, or the button 400s.
VITE_AUTH_PROVIDERS=google
