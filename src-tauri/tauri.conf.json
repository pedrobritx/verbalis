{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verbalis",
  "version": "0.0.1",
  "identifier": "app.verbalis.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173/verbalis/",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Verbalis",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/icons/icon-192.png",
      "../public/icons/icon-512.png"
    ]
  }
}
